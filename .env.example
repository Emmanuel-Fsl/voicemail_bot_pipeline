# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=ADD_YOUR_ELEVENLABS_KEY_HERE

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=ADD_YOUR_OPENAI_KEY_HERE

# ── Google Cloud (BigQuery + Firestore) ───────────────────────────────────────
# Path to your service account JSON file (keep it in this folder).
# Download from: GCP Console → IAM → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
GMAIL_SENDER=payments@fsldigital.com
# Gmail App Password (not your login password).
# Generate at: https://myaccount.google.com/apppasswords (needs 2FA enabled)
GMAIL_APP_PASSWORD=ADD_YOUR_GMAIL_APP_PASSWORD_HERE

# ── Alert recipient ───────────────────────────────────────────────────────────
ALERT_RECIPIENT=payments@fsldigital.com
